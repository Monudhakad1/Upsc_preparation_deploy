# Copy to backend/.env - it is loaded automatically on startup (and is git-ignored).

DATABASE_URL=jdbc:postgresql://localhost:5432/upsc_mentor
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# At least 32 bytes. Generate with: openssl rand -base64 48
APP_JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes
APP_JWT_EXPIRATION_MS=86400000

# Comma-separated frontend origins, no trailing slash
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

PORT=8080

# The only two accounts - created automatically on first boot
SEED_MENTOR_EMAIL=mentor@example.com
SEED_MENTOR_PASSWORD=change-me-mentor
SEED_MENTOR_NAME=Mentor

SEED_ASPIRANT_EMAIL=aspirant@example.com
SEED_ASPIRANT_PASSWORD=change-me-aspirant
SEED_ASPIRANT_NAME=Aspirant
